# Shared defaults for every environment.
# Only VITE_* variables are exposed to the client bundle, so never put
# passwords, private API keys or access tokens in this file.

VITE_APP_NAME=Todo
VITE_APP_DESCRIPTION=Приложение для управления списком задач: добавление, поиск, фильтрация и настройки.
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API prefix. The mock server is proxied through /api in development.
VITE_API_BASE_URL=/api

# Base path of the deployed SPA (GitHub Pages overrides this in CI).
VITE_BASE_PATH=/

# Canonical site URL. Leave empty locally; the deploy workflow fills it in.
VITE_PUBLIC_SITE_URL=
VITE_OG_IMAGE=icons/favicon-128x128.png

# Set to true to use the in-browser demo API (GitHub Pages preview).
VITE_USE_MOCK_API=false

# Monitoring. The Sentry integration works in mock mode unless a DSN and an
# endpoint are provided; no data leaves the browser in mock mode.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_MONITORING_ENDPOINT=
VITE_ANALYTICS_ENABLED=false
