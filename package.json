{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "Todo app built with Quasar, Vue 3 and Pinia",
  "productName": "Todo",
  "author": "Alex",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./tests/**/*.{ts,js,cjs,mjs,vue}\" \"vitest.config.ts\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./tests/**/*.{ts,js,cjs,mjs,vue}\" \"vitest.config.ts\"",
    "dev": "quasar dev -p 9005",
    "mock": "npm start --prefix mock",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && quasar build",
    "build:analyze": "node scripts/clean.mjs && node scripts/build-analyze.mjs && node scripts/analyze-bundle.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "preview": "node scripts/preview.mjs",
    "audit:lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "audit:lighthouse:mobile": "npm run build && node scripts/lighthouse.mjs --mobile",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint:check && npm run test:coverage",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.13.2",
    "pinia": "^4.0.2",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
