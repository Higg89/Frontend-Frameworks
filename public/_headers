# Cache-Control for hosts that support the _headers format
# (Netlify, Cloudflare Pages). GitHub Pages manages caching itself.
#
# Fingerprinted assets never change, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML entry point must always be revalidated so a new release is picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/_redirects
  Cache-Control: public, max-age=3600
