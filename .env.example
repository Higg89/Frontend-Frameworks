# Copy to .env.local and fill in values for your machine.
# .env.local is ignored by git and is never committed.
#
# WARNING: every VITE_* variable is embedded into the client bundle.
# Never store passwords, private API keys or access tokens here.

VITE_APP_NAME=Todo
VITE_APP_DESCRIPTION=Приложение для управления списком задач: добавление, поиск, фильтрация и настройки.
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

VITE_API_BASE_URL=/api
VITE_BASE_PATH=/
VITE_PUBLIC_SITE_URL=
VITE_OG_IMAGE=icons/favicon-128x128.png
VITE_USE_MOCK_API=false

# Sentry is mocked by default. To connect a real Sentry project, install
# @sentry/vue and set these values in .env.local (or in GitHub Secrets).
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_MONITORING_ENDPOINT=
VITE_ANALYTICS_ENABLED=false
